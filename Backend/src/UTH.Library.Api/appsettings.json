{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MigrateOnStartup": false
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "Audit": {
    "RetentionDays": 365
  },
  "AI": {
    "Provider": "OpenAI",
    "EmbeddingModel": "text-embedding-3-small",
    "EmbeddingDimensions": 1536,
    "BaseUrl": "https://api.openai.com/v1/",
    "ApiKey": ""
  },
  "Jwt": {
    "Issuer": "UTH.Library.Api",
    "Audience": "UTH.Library.Client",
    "PrivateKeyPemPath": "../pem/jwt-private.pem",
    "PublicKeyPemPath": "../pem/jwt-public.pem",
    "KeyId": "uth-library-rsa-2026-01",
    "AccessTokenMinutes": 10,
    "RefreshTokenDays": 30,
    "RequireConfirmedEmail": false
  }
}
